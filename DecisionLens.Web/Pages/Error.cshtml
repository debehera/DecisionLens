@page
@model DecisionLens.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="dl-empty mt-4">
    <p class="dl-count mb-1">Error</p>
    <h1 class="h3 mb-3">Something went wrong</h1>
    <p class="mb-3">The app hit an unexpected problem. Please try again. If it keeps happening, come back a little later.</p>
    <a asp-page="/Index" class="btn dl-btn-primary">Go to the home page</a>
    <p class="text-muted small mt-3 mb-0">Reference: @Model.RequestId</p>
</div>