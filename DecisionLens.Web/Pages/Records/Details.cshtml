@page "{id:int}"
@model DecisionLens.Web.Pages.Records.DetailsModel
@using DecisionLens.Web.Models
@{
    ViewData["Title"] = Model.Record.Title;
}
@functions {
    private static bool IsBlank(string? text) => string.IsNullOrWhiteSpace(text);

    // Blank text and the AI's "Not stated in the discussion" are both shown in a muted style.
    private static bool IsMuted(string? text) => IsBlank(text) || text!.Trim() == TogafCatalog.NotStated;
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}

<div class="dl-card mb-4">
    <div class="mb-2"><partial name="_AdmBadge" model="Model.Record" /></div>
    <h1 class="h3 mb-3">@Model.Record.Title</h1>

    <dl class="dl-meta">
        <dt>Status</dt><dd>@Model.Record.Status</dd>
        <dt>Date</dt><dd>@Model.Record.DecisionDate.ToString("yyyy-MM-dd")</dd>
        <dt>Owner</dt><dd>@(IsBlank(Model.Record.Owner) ? "Not set" : Model.Record.Owner)</dd>
    </dl>

    <h2 class="h6 dl-label">Context</h2>
    <p class="dl-text @(IsMuted(Model.Record.Context) ? "dl-muted" : "")">@(IsBlank(Model.Record.Context) ? "Not provided" : Model.Record.Context)</p>

    <h2 class="h6 dl-label">Decision</h2>
    <p class="dl-text @(IsMuted(Model.Record.Decision) ? "dl-muted" : "")">@(IsBlank(Model.Record.Decision) ? "Not provided" : Model.Record.Decision)</p>

    <h2 class="h6 dl-label">Options considered</h2>
    <p class="dl-text @(IsMuted(Model.Record.OptionsConsidered) ? "dl-muted" : "")">@(IsBlank(Model.Record.OptionsConsidered) ? "Not provided" : Model.Record.OptionsConsidered)</p>

    <h2 class="h6 dl-label">Rationale</h2>
    <p class="dl-text @(IsMuted(Model.Record.Rationale) ? "dl-muted" : "")">@(IsBlank(Model.Record.Rationale) ? "Not provided" : Model.Record.Rationale)</p>

    <h2 class="h6 dl-label">Consequences and risks</h2>
    <p class="dl-text @(IsMuted(Model.Record.Consequences) ? "dl-muted" : "")">@(IsBlank(Model.Record.Consequences) ? "Not provided" : Model.Record.Consequences)</p>
</div>

<div class="dl-actions">
    <a asp-page="/Records/Edit" asp-route-id="@Model.Record.Id" class="btn dl-btn-primary">Edit</a>
    <a asp-page="/Records/Print" asp-route-id="@Model.Record.Id" target="_blank" rel="noopener" class="btn dl-btn-outline">Print</a>
    <a asp-page="/Records/Details" asp-page-handler="Markdown" asp-route-id="@Model.Record.Id" class="btn dl-btn-outline">Markdown</a>

    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Record.Id"
          data-confirm="Delete this record? This cannot be undone.">
        <button type="submit" class="btn dl-btn-danger">Delete</button>
    </form>

    <a asp-page="/Records/Index" class="btn dl-btn-outline">Back to records</a>
    <a asp-page="/Capture" class="btn dl-btn-outline">New record</a>
</div>