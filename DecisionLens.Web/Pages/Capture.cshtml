@page
@model CaptureModel
@{
    ViewData["Title"] = "New record";
}

<h1>New record <small class="text-muted fs-5">(temporary Day 3 test page)</small></h1>
<p class="text-muted">Paste a fictional discussion and click Draft. The real capture screen comes on Day 5.</p>

<p>
    Load a sample:
    <a asp-page="/Capture" asp-route-sample="1">1 Database chat</a> |
    <a asp-page="/Capture" asp-route-sample="2">2 API gateway notes</a> |
    <a asp-page="/Capture" asp-route-sample="3">3 Legacy billing email</a> |
    <a asp-page="/Capture" asp-route-sample="4">4 Thin chat (test only)</a>
</p>

<form method="post">
    <textarea asp-for="Discussion" class="form-control" rows="12" placeholder="Paste a discussion here"></textarea>
    <div class="form-text">Limit: @Model.MaxChars.ToString("N0") characters. Currently: @((Model.Discussion ?? "").Length.ToString("N0")).</div>
    <button class="btn dl-btn-primary mt-3" type="submit">Draft record</button>
</form>

@if (Model.Outcome is not null)
{
    if (!Model.Outcome.Success)
    {
        <div class="alert alert-warning mt-4" role="alert">
            @Model.Outcome.Message
            <small class="text-muted">(code: @Model.Outcome.ErrorCode)</small>
        </div>
    }
    else
    {
        var r = Model.Outcome.Record!;
        var n = Model.Outcome.Note!;
        <div class="dl-card mt-4">
            <h2>@r.Title</h2>
            <dl class="mb-0">
                <dt>Decision</dt><dd>@r.Decision</dd>
                <dt>Context</dt><dd>@r.Context</dd>
                <dt>Options considered</dt><dd style="white-space:pre-line">@r.OptionsConsidered</dd>
                <dt>Rationale</dt><dd>@r.Rationale</dd>
                <dt>Consequences and risks</dt><dd>@r.Consequences</dd>
                <dt>ADM phase</dt><dd>@r.AdmPhase</dd>
                <dt>Architecture domain</dt><dd>@r.Domain</dd>
                <dt>AI note (not saved)</dt><dd>Confidence: @n.Confidence. @n.Reason</dd>
            </dl>
        </div>
    }
}