@page "/Status/{code:int?}"
@model DecisionLens.Web.Pages.StatusModel
@{
    ViewData["Title"] = Model.Heading;
}

<div class="dl-empty mt-4">
    <p class="dl-count mb-1">Error @Model.Code</p>
    <h1 class="h3 mb-3">@Model.Heading</h1>
    <p class="mb-3">@Model.Message</p>
    <a asp-page="/Index" class="btn dl-btn-primary">Go to the home page</a>
    <a asp-page="/Records/Index" class="btn dl-btn-outline">View records</a>
</div>